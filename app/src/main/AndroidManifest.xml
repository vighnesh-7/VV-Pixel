<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- For querying system clock and alarm intent configurations under Android 11+ -->
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <package android:name="com.google.android.deskclock" />
        <package android:name="com.android.deskclock" />
        <package android:name="com.sec.android.app.clockpackage" />
        <package android:name="com.huawei.deskclock" />
        <package android:name="com.xiaomi.deskclock" />
        <package android:name="com.oppo.deskclock" />
        <package android:name="com.oneplus.deskclock" />
        <package android:name="com.coloros.deskclock" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        tools:targetApi="34">
        
        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Dynamic Volume Dialog Activity -->
        <activity
            android:name=".VolumeControlActivity"
            android:theme="@style/Theme.TranslucentActivity"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:label="Volume Overlay" />

        <!-- Services -->
        <service
            android:name=".VVPixelAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".ShakeTorchService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shake gesture listening to toggle low-level hardware flashlight camera torch." />
        </service>



        <!-- Quick Settings Tiles -->
        <service
            android:name=".AdaptiveBrightnessTileService"
            android:icon="@drawable/ic_brightness_auto"
            android:label="Adaptive Brightness"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".VolumeTileService"
            android:icon="@drawable/ic_volume_equalizer"
            android:label="Quick Volume"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".RingerModeTileService"
            android:icon="@drawable/ic_unmute"
            android:label="Ringer Mode"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- Samsung dynamic split-click metadata -->
            <meta-data android:name="com.samsung.android.quicksettings.action.DETAIL_VIEW" android:value="true" />
        </service>

        <service
            android:name=".CaffeinateTileService"
            android:icon="@drawable/ic_coffee"
            android:label="Caffeinate"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Dynamic Ringer Mode Dialog/Overlay Activity -->
        <activity
            android:name=".RingerModeDetailActivity"
            android:theme="@style/Theme.TranslucentActivity"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:label="Ringer Choices">
            <intent-filter>
                <action android:name="com.samsung.android.quicksettings.action.DETAIL_VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Home Screen Widgets -->
        <receiver
            android:name=".LockWidget2x1"
            android:label="VV Lock Screen (2x1)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lock_widget_info" />
        </receiver>

        <receiver
            android:name=".DoubleTapLockWidget"
            android:label="VV Double Tap Invisible Zone (1x1)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.vvpixel.ACTION_DOUBLE_TAP_CLICK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/double_tap_widget_info" />
        </receiver>

        <receiver
            android:name=".CalculatorWidget"
            android:label="VV Pocket Calculator"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.vvpixel.CALC_KEY_*" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calculator_widget_info" />
        </receiver>

        <receiver
            android:name=".RingerToggleWidget"
            android:label="VV Ringer Toggle Widget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.media.RINGER_MODE_CHANGED" />
                <action android:name="com.example.vvpixel.ACTION_SET_RINGER_VIBRATE" />
                <action android:name="com.example.vvpixel.ACTION_SET_RINGER_MUTE" />
                <action android:name="com.example.vvpixel.ACTION_SET_RINGER_UNMUTE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ringer_widget_info" />
        </receiver>

        <!-- Doodle Clock Widgets -->
        <receiver
            android:name=".DoodleFaceClockWidget"
            android:label="Doodle Cozy Face Clock"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/doodle_face_widget_info" />
        </receiver>

        <receiver
            android:name=".BlobMonsterClockWidget"
            android:label="Doodle Blob Monster Clock"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/blob_monster_widget_info" />
        </receiver>

        <receiver
            android:name=".NothingPixelClockWidget"
            android:label="Doodle Nothing LED Clock"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nothing_pixel_widget_info" />
        </receiver>

        <receiver
            android:name=".LiquidGlassClockWidget"
            android:label="iOS Liquid Glass Clock"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/liquid_glass_widget_info" />
        </receiver>

    </application>

</manifest>
