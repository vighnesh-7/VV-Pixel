<?xml version="1.0" encoding="utf-8"?>
<!--
  Fix (Bug 6): QS tile icons must be a single tintable shape so Android can
  apply the correct active/inactive tint automatically. The previous version
  hardcoded fillColor/strokeColor to #000000 and a fixed #3B82F6 blue, which
  is invisible against a dark QS panel background and ignores system tinting
  entirely. android:tint="?android:attr/colorControlNormal" lets the system color it
  correctly in both light and dark Material You themes, and TileService's own
  state-based tinting (active vs inactive) still applies on top of this.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?android:attr/colorControlNormal">

    <!-- Track 1 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:pathData="M6,4 L6,20" />

    <!-- Track 2 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:pathData="M12,4 L12,20" />

    <!-- Track 3 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:pathData="M18,4 L18,20" />

    <!-- Knob 1 (top) -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M 6,7 m -3,0 a 3,3 0 1,1 6,0 a 3,3 0 1,1 -6,0" />

    <!-- Knob 2 (middle) -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M 12,12 m -3,0 a 3,3 0 1,1 6,0 a 3,3 0 1,1 -6,0" />

    <!-- Knob 3 (bottom) -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M 18,17 m -3,0 a 3,3 0 1,1 6,0 a 3,3 0 1,1 -6,0" />
</vector>
