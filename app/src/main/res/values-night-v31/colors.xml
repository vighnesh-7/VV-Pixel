<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- On Android 12+ dark theme, map active widget state color dynamically to lightened system accent -->
    <color name="widget_btn_active_bg">@android:color/system_accent1_300</color>
    <color name="widget_btn_active_icon">@android:color/system_neutral1_900</color>

    <!-- Opaque subtle mix of dynamic wallpaper background for Ringer widget (Dark Mode) -->
    <color name="ringer_glass_bg_start">@android:color/system_neutral1_900</color>
    <color name="ringer_glass_bg_end">@android:color/system_accent1_900</color>
    <color name="ringer_glass_outline">@android:color/system_accent1_700</color>

    <!-- Dynamic lock widget background and contrast matched icon (Dark Mode) -->
    <color name="lock_widget_bg">@android:color/system_accent1_800</color>
    <color name="lock_widget_icon">@android:color/system_accent1_100</color>
</resources>
