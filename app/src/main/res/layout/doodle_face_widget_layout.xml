<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <!-- Left side Content Column (Padded) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:layout_toStartOf="@+id/doodle_image"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_marginEnd="2dp">

        <!-- Time TextClock -->
        <TextClock
            android:id="@+id/widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="h:mm"
            android:textColor="#FFFFFF"
            android:textSize="48sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:layout_marginTop="-4dp" />

        <!-- Date TextClock -->
        <TextClock
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE\nd MMM"
            android:format24Hour="EEEE\nd MMM"
            android:textColor="#CCFFFFFF"
            android:textSize="15sp"
            android:textStyle="normal"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false" />

        <!-- Alarm details box -->
        <LinearLayout
            android:id="@+id/alarm_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/double_tap_zone_background"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:layout_marginTop="6dp">

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:src="@android:drawable/ic_lock_idle_alarm"
                android:tint="#FFF9C4"
                android:contentDescription="Alarm Icon" />

            <TextView
                android:id="@+id/alarm_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sleep Well"
                android:textColor="#FFF9C4"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginStart="4dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Right side Cozy Face sitting flush on bottom-right corner -->
    <ImageView
        android:id="@+id/doodle_image"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:scaleType="fitEnd"
        android:src="@drawable/ic_doodle_face_cozy"
        android:contentDescription="Cozy Face Doodle" />

</RelativeLayout>
